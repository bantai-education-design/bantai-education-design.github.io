    "publish_rule": "権利確認済み実画像（verified）または本DB向けに独立生成したオリジナルAI画像（ai_original）のみ公開カードへ表示する。",
    "required_fields_when_verified": [
      "university_id",
      "image_url",
      "source_url",
      "rights_note",
      "alt"
